SPLITWISE_API_KEY=
ANTHROPIC_API_KEY=

# Turso (SQLite cloud) — lascia vuote per usare SQLite locale (backend/finance.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Lascia vuota per l'app desktop (nessuna autenticazione, il backend ascolta
# solo su 127.0.0.1). Impostala solo se il backend è esposto su internet
# (es. hosted su Fly.io per l'app mobile) — genera un token con
# `openssl rand -hex 32` e usa lo stesso valore nell'app mobile.
API_ACCESS_TOKEN=
