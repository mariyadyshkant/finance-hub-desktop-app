# Copia in `.env` e compila. `.env` è in .gitignore — non committarlo mai.
# In produzione (Fly.io) questi valori vanno impostati con `fly secrets set`,
# non dentro un file nel pacchetto.

# ─── Splitwise (opzionale) ───
# Preferibile configurarla dalla pagina Impostazioni dentro l'app desktop.
SPLITWISE_API_KEY=

# ─── Claude (parsing spese del bot Telegram) ───
ANTHROPIC_API_KEY=

# ─── Turso (database cloud condiviso desktop ⇆ bot) ───
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Backend hosted per l'app mobile (opt-in) ───
# Se impostata, ogni richiesta al backend deve portare l'header X-API-Token.
# Lasciare vuota per l'uso desktop locale.
API_ACCESS_TOKEN=

# ─── Bot Telegram ───
# Token da @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Il tuo chat_id personale: il bot risponde SOLO a questo.
# Si trova su https://api.telegram.org/bot<TOKEN>/getUpdates dopo aver
# scritto un messaggio al bot (campo message.chat.id).
TELEGRAM_CHAT_ID=
# Segreto condiviso con Telegram per autenticare le chiamate al webhook.
# Generalo con: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Modello per interpretare le frasi ("ho pagato 45 dal dentista").
# Default se vuoto: claude-opus-5. Alternativa economica: claude-haiku-4-5
TELEGRAM_PARSER_MODEL=
