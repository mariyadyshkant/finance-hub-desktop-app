{
  "name": "finance-hub-desktop",
  "version": "0.1.0",
  "description": "Finance Hub — app desktop nativa (Electron + Svelte + FastAPI)",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:electron": "wait-on tcp:5173 && ELECTRON_START_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k \"npm:dev:frontend\" \"npm:dev:electron\"",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend && electron-builder",
    "start": "electron ."
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.mariyadyshkant.financehub",
    "productName": "Finance Hub",
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "!backend/**/__pycache__/**",
      "!backend/*.db"
    ],
    "mac": {
      "category": "public.app-category.finance"
    }
  }
}
